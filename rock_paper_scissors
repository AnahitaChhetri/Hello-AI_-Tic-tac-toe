import random
print("GameBot: Welcome to the Rock Paper Scissors Bot!")
choices={1:"rock", 2:"paper", 3:"scissors"}
def general_chatbot():
    ai_choice=random.choice(list(choices))
    
    user_choice=input("GameBot: Rock, paper, scissors, shoot! Choose your option!").lower()
    if user_choice=="scissors":
        user_choice=3
    elif user_choice=="paper":
        user_choice=2
    else:
        user_choice=1
    final_choices=(ai_choice, user_choice)
    ai_wins=[(2,1), (1,3), (3,2)]
    user_wins=[(1,2), (3,1), (2,3)]
    if final_choices in ai_wins:
        print(f"GameBot: I won! Nice try! I chose: {choices[ai_choice]}, and you chose {choices[user_choice]}!")
    elif final_choices in user_wins:
        print(f"GameBot: You won! Amazing job! I chose: {choices[ai_choice]}, and you chose {choices[user_choice]}!")
    else:
        print("GameBot: It's a tie!")
def replay():
    play_again=input("GameBot: Would you like to play again? (y/n):").lower()
    while play_again=="y":
        general_chatbot()
        replay()
    if play_again=="n":
        print("GameBot: Thank you so much for playing! Have a good day! ;) ")

general_chatbot()
replay()